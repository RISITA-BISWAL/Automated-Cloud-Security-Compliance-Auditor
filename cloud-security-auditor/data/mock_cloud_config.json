{
  "cloud_environment": "mock",
  "version": "1.0",
  "resources": [
    {
      "type": "storage",
      "name": "production-data",
      "public_access": false,
      "encrypted": true,
      "region": "us-east-1"
    },
    {
      "type": "storage",
      "name": "public-assets",
      "public_access": true,
      "encrypted": true,
      "region": "us-east-1"
    },
    {
      "type": "storage",
      "name": "backup-storage",
      "public_access": false,
      "encrypted": false,
      "region": "us-west-2"
    },
    {
      "type": "storage",
      "name": "log-archive",
      "public_access": false,
      "encrypted": true,
      "region": "eu-west-1"
    },
    {
      "type": "storage",
      "name": "temp-uploads",
      "public_access": true,
      "encrypted": false,
      "region": "us-east-1"
    },
    {
      "type": "vm",
      "name": "web-server-1",
      "encrypted": true,
      "public_ip": true,
      "open_ports": [80, 443],
      "region": "us-east-1"
    },
    {
      "type": "vm",
      "name": "app-server-1",
      "encrypted": true,
      "public_ip": false,
      "open_ports": [8080, 8443],
      "region": "us-east-1"
    },
    {
      "type": "vm",
      "name": "db-server-1",
      "encrypted": false,
      "public_ip": true,
      "open_ports": [22, 3306],
      "region": "us-west-2"
    },
    {
      "type": "vm",
      "name": "admin-workstation",
      "encrypted": true,
      "public_ip": true,
      "open_ports": [3389],
      "region": "eu-west-1"
    },
    {
      "type": "vm",
      "name": "monitoring-server",
      "encrypted": true,
      "public_ip": false,
      "open_ports": [9090, 3000],
      "region": "us-east-1"
    },
    {
      "type": "database",
      "name": "primary-db",
      "encrypted": true,
      "public_access": false,
      "region": "us-east-1"
    },
    {
      "type": "database",
      "name": "analytics-db",
      "encrypted": true,
      "public_access": true,
      "region": "us-west-2"
    },
    {
      "type": "database",
      "name": "staging-db",
      "encrypted": false,
      "public_access": false,
      "region": "eu-west-1"
    },
    {
      "type": "database",
      "name": "user-sessions",
      "encrypted": true,
      "public_access": false,
      "region": "us-east-1"
    },
    {
      "type": "database",
      "name": "legacy-db",
      "encrypted": false,
      "public_access": true,
      "region": "us-west-2"
    },
    {
      "type": "iam",
      "username": "alice",
      "role": "admin",
      "mfa_enabled": true
    },
    {
      "type": "iam",
      "username": "bob",
      "role": "developer",
      "mfa_enabled": false
    },
    {
      "type": "iam",
      "username": "charlie",
      "role": "admin",
      "mfa_enabled": false
    },
    {
      "type": "iam",
      "username": "diana",
      "role": "security_admin",
      "mfa_enabled": false
    },
    {
      "type": "iam",
      "username": "eve",
      "role": "analyst",
      "mfa_enabled": true
    }
  ]
}
